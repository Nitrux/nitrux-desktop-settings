#!/sbin/openrc-run

supervisor="supervise-daemon"
supervise_daemon_args="--respawn-delay 1 --respawn-max 5"
command="/usr/bin/ksecretd"

start_pre() {
    local user_uid kwallet_socket

    user_uid="$(id -u)"
    kwallet_socket="/run/user/${user_uid}/kwallet5.socket"

    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${PAM_KWALLET5_LOGIN:-}" ] && [ -S "$kwallet_socket" ] && [ -x /usr/share/libpam-kwallet-common/pam_kwallet_init ]; then
        /usr/share/libpam-kwallet-common/pam_kwallet_init || true
    fi
}
