# -- Exit on errors.

set -eu


# -- Functions.

ensure_breeze_runtimes() {
    local missing=()
    for theme in "org.gtk.Gtk3theme.Breeze" "org.gtk.Gtk3theme.Breeze-Dark"; do
        if ! flatpak list --runtime --columns=application | grep -q "^${theme}$"; then
            missing+=("$theme")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        flatpak install -y --user flathub "${missing[@]}"
    fi
}

# -- Add flathub.

flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo


# -- Ensure GTK theme runtimes.

ensure_breeze_runtimes


# -- Install Steam flatpak.

notify-send -a "System Message" -i "steam" "Installing Steam in the background, please wait..."

FPK_APP="com.valvesoftware.Steam"

flatpak install -y --user $FPK_APP

notify-send -a "System Message" -i "steam" "Installation complete."


# -- Check if Steam is installed an delete install script.

if flatpak list --app --columns=application | grep -q "$FPK_APP"; then
    rm -f "$HOME/.local/bin/install-steam-flatpak"
    rm -f "$HOME/.local/share/applications/install.steam.flatpak.desktop"
fi

notify-send -a "System Message" -i "steam" "Launching Steam."

flatpak run $FPK_APP &

exit
