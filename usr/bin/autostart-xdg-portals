#!/usr/bin/env bash

# SPDX-License-Identifier: BSD-3-Clause
# Copyright 2024-2026 <Nitrux Latinoamericana S.C. <hello@nxos.org>>


# -- Exit on unset variables.

set -u


# -- Constants.

readonly log_tag="autostart-xdg-portals"
readonly portal_bus_name="org.freedesktop.portal.Desktop"
readonly portal_object_path="/org/freedesktop/portal/desktop"
readonly max_attempts=10

readonly -a required_interfaces=(
    FileChooser
    OpenURI
    ScreenCast
    Screenshot
    Settings
)


# -- Functions.

log() {
    logger -t "$log_tag" -- "$*"
}

fail() {
    log "Error: $*"
    exit 1
}


# -- Validate the runtime environment.

for required_command in dbus-update-activation-environment gdbus grep killall logger sleep timeout; do
    command -v "$required_command" >/dev/null 2>&1 ||
        fail "Required command not found: $required_command"
done

if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} && -z ${XDG_RUNTIME_DIR:-} ]]; then
    fail "No D-Bus session address or XDG runtime directory is available"
fi


# -- Update the environment used to D-Bus-activate the portal services.
#   -- Publishing the complete session environment preserves Qt and KDE theme
#      variables that the portal backends inherited when launched directly.

export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-kde}"

log "Restarting XDG desktop portals"

if ! dbus-update-activation-environment --all; then
    fail "Could not update the D-Bus activation environment"
fi


# -- Stop stale portal processes, then let D-Bus reactivate the configured stack.

timeout 5s killall --wait xdg-desktop-portal xdg-desktop-portal-kde \
    xdg-desktop-portal-hyprland 2>/dev/null || true


# -- Wait for the configured portal interfaces.

declare portal_info=""
declare -a missing_interfaces=()

for ((attempt = 1; attempt <= max_attempts; attempt++)); do
    log "Checking portal interfaces (attempt $attempt/$max_attempts)"

    if portal_info=$(timeout 5s gdbus introspect --session \
        --dest "$portal_bus_name" \
        --object-path "$portal_object_path" 2>/dev/null); then
        missing_interfaces=()

        for interface in "${required_interfaces[@]}"; do
            if ! grep -Fq "interface org.freedesktop.portal.$interface" \
                <<<"$portal_info"; then
                missing_interfaces+=("$interface")
            fi
        done

        if ((${#missing_interfaces[@]} == 0)); then
            log "XDG desktop portals are ready"
            exit 0
        fi

        log "Interfaces not ready: ${missing_interfaces[*]}"
    else
        log "The portal service has not acquired its D-Bus name yet"
    fi

    if ((attempt < max_attempts)); then
        sleep 1
    fi
done

fail "Portal interfaces did not become ready after $max_attempts attempts"
