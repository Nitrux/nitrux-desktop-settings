#!/usr/bin/env bash

# SPDX-License-Identifier: BSD-3-Clause
# Copyright 2026 Nitrux Latinoamericana S.C. <hello@nxos.org>

set -euo pipefail

readonly agent_name="polkit-nx-agent"
uid="$(id -u)"
readonly uid

warn()
{
    printf "%s: %s\n" "${0##*/}" "$*" >&2
}

is_running()
{
    command -v pgrep >/dev/null 2>&1 || return 1
    pgrep -u "$uid" -x "$agent_name" >/dev/null 2>&1
}

agent=""
for candidate in /usr/lib/*/libexec/"$agent_name" "/usr/libexec/$agent_name" "/usr/lib/$agent_name"; do
    if [[ -x "$candidate" ]]; then
        agent="$candidate"
        break
    fi
done

if [[ -z "$agent" ]]; then
    warn "PolicyKit agent not found; skipping startup"
    exit 0
fi

if is_running; then
    exit 0
fi

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$uid}"
if [[ ! -d "$runtime_dir" || ! -w "$runtime_dir" ]]; then
    runtime_dir="${TMPDIR:-/tmp}"
fi
lock_file="$runtime_dir/nitrux-polkit-agent.lock"

if command -v flock >/dev/null 2>&1; then
    (
        flock -n 9 || exit 0
        is_running && exit 0
        exec "$agent"
    ) 9>"$lock_file" &
else
    "$agent" &
fi
