# -- Exit on errors.

set -eu


# -- Start Nitrux PolicyKit agent.

ARCH=$(uname -m)

POLKIT_AGENT="/usr/lib/$ARCH/libexec/polkit-nx-agent"

[ -x "$POLKIT_AGENT" ] || POLKIT_AGENT="/usr/lib/polkit-nx-agent"


# -- Start the Polkit Agent (Password prompts).

pgrep -fu "$USER" polkit-nx-agent >/dev/null || "$POLKIT_AGENT" &
