#!/usr/bin/env bash

# SPDX-License-Identifier: BSD-3-Clause
# Copyright 2026 <Nitrux Latinoamericana S.C. <hello@nxos.org>>


# -- Exit on errors.

set -eu


# -- Run the KWallet PAM handoff helper only when the PAM variables exist.

USER_UID="$(id -u)"
KWALLET_SOCKET="/run/user/${USER_UID}/kwallet5.socket"

if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${PAM_KWALLET5_LOGIN:-}" ] && [ -S "$KWALLET_SOCKET" ]; then
    /usr/share/libpam-kwallet-common/pam_kwallet_init || true
fi

# -- 1. Start the Secrets Daemon (Password storage).

pgrep -xu "$USER" ksecretd >/dev/null || ksecretd >/dev/null 2>&1 &


# -- 2. Start KWallet Daemon (KDE Wallet).

pgrep -xu "$USER" kwalletd6 >/dev/null || kwalletd6 >/dev/null 2>&1 &


# -- 3. Start kded6.

pgrep -xu "$USER" kded6 >/dev/null || kded6 >/dev/null 2>&1 &
